# Copy to .env and fill in. Never commit .env.
JOBAPPLY_DATABASE_URL=sqlite:///jobapply.db
JOBAPPLY_DATA_DIR=data
JOBAPPLY_LOG_LEVEL=INFO
JOBAPPLY_LOG_JSON=false
JOBAPPLY_DRY_RUN=true
JOBAPPLY_KILL_SWITCH=false
JOBAPPLY_SECRET_KEY=change-me
# Generate with: uv run jobapply vault-key
JOBAPPLY_VAULT_KEY=
# fake = no network, deterministic. live = walk JOBAPPLY_LLM_PROVIDERS in order, failing over when one
# is rate limited, out of credits or down. A provider is skipped when its key is empty (ollama needs none).
# Each *_API_KEY takes one key or several separated by commas (or newlines in a quoted value); *_API_KEYS is an
# alias for the list. Keys of one provider rotate round-robin and a 429 / quota / bad key only parks that key.
# Example: JOBAPPLY_GEMINI_API_KEY=AIza...first,AIza...second   See docs/AI_KEYS.md.
JOBAPPLY_LLM_BACKEND=fake
JOBAPPLY_LLM_PROVIDERS=claude,openai,gemini,openrouter,groq,together,mistral,deepseek,xai,ollama
JOBAPPLY_ANTHROPIC_API_KEY=
JOBAPPLY_CLAUDE_MODEL=claude-opus-5-5
JOBAPPLY_CLAUDE_EFFORT=medium
JOBAPPLY_OPENAI_API_KEY=
JOBAPPLY_OPENAI_MODEL=
JOBAPPLY_OPENAI_BASE_URL=
JOBAPPLY_GEMINI_API_KEY=
JOBAPPLY_GEMINI_MODEL=
JOBAPPLY_OPENROUTER_API_KEY=
JOBAPPLY_GROQ_API_KEY=
JOBAPPLY_TOGETHER_API_KEY=
JOBAPPLY_MISTRAL_API_KEY=
JOBAPPLY_DEEPSEEK_API_KEY=
JOBAPPLY_XAI_API_KEY=
JOBAPPLY_OLLAMA_BASE_URL=
JOBAPPLY_OLLAMA_MODEL=
JOBAPPLY_LLM_COOLDOWN_MINUTES=10
JOBAPPLY_SCORE_THRESHOLD=70
JOBAPPLY_ADZUNA_APP_ID=
JOBAPPLY_ADZUNA_APP_KEY=
JOBAPPLY_ADZUNA_COUNTRY=in
JOBAPPLY_RAPIDAPI_KEY=
JOBAPPLY_WHATSAPP_BASE_URL=
JOBAPPLY_WHATSAPP_TOKEN=
JOBAPPLY_CHROMIUM_EXECUTABLE=
# LinkedIn (assisted). false keeps the window visible, which login and challenges need; true only
# for unattended check/apply runs once a session is saved in data/browser-profiles/<user>/linkedin.
JOBAPPLY_LINKEDIN_HEADLESS=false
# Local-time window in which LinkedIn runs are allowed (HH:MM-HH:MM); outside it they are skipped.
JOBAPPLY_LINKEDIN_ACTIVE_HOURS=08:00-23:00
