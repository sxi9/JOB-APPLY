[Unit]
Description=JOB-APPLY worker (scoring, applying, inbox, follow-ups, summaries; user service)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/jobapply
EnvironmentFile=%h/jobapply/.env
ExecStart=%h/jobapply/.venv/bin/jobapply schedule -g worker
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
