[Unit]
Description=JOB-APPLY collectors (scheduler, collector group)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jobapply
Group=jobapply
WorkingDirectory=/opt/jobapply
EnvironmentFile=/opt/jobapply/.env
ExecStart=/opt/jobapply/.venv/bin/jobapply schedule -g collector
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/jobapply

[Install]
WantedBy=multi-user.target
