[Unit]
Description=JOB-APPLY dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jobapply
Group=jobapply
WorkingDirectory=/opt/jobapply
EnvironmentFile=/opt/jobapply/.env
ExecStart=/opt/jobapply/.venv/bin/jobapply serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/jobapply

[Install]
WantedBy=multi-user.target
